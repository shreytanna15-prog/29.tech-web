# Full Cal.com URL or path — both work
NEXT_PUBLIC_CAL_LINK=https://cal.com/shrey-tanna-ydglsi/project-discovery-call-29.tech

# Webhook for contact form notifications (Zapier, Slack, Make, etc. - optional)
CONTACT_WEBHOOK_URL=

# Supabase PostgreSQL Connection Strings
# Transaction pooler URL (port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URL (port 5432) for migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Stealth Admin Panel Configuration
# Obfuscated path for admin panel (e.g. /_sys_29tech_k8) — DO NOT use /admin or /dashboard
ADMIN_SECRET_PATH="_sys_29_k8"

# Admin Authentication
ADMIN_USERNAME="admin"
# Bcrypt hash of admin password (or raw password in dev)
# Default for 'Admin29!Secure': $2a$12$e0X9/sAomR8f.CsqgZ2yfeD7k7fE/r39R75e7W92wD44IUkTq4Q6W
ADMIN_PASSWORD_HASH="$2b$10$10tgjAegiwYqnFquaTUHju0iqaGXp6vV80asyXHYEY2XthywkYFXW"
# Secret key for JWT session cookies (at least 32 characters)
ADMIN_JWT_SECRET="slug-here"
